# Secrets — never commit. .env.example is the only exception.
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Node / Next
node_modules/
.next/
out/

# Local dev storage
.vmlab-storage/

# Client-confidential material. The split documents and extracted fixtures are
# derived from Abdul's own corpus, which is marked Confidential Enterprise
# Reference, and the VM decks are third-party retailer property. Only the
# manifest (metadata, no content) is tracked.
data/split/*.pdf
data/fixtures/
data/benchmark/

# TypeScript incremental build cache
*.tsbuildinfo
