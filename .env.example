# Copy to .env and fill in. Never commit the real file.

ENVIRONMENT=development

# --- Database -----------------------------------------------------------
# Local development uses the Docker Postgres started by db/test/run.sh.
# In deployment this is the Supabase connection string.
DATABASE_URL=postgresql://postgres:vmlab@localhost:55432/vmlab

# --- Supabase -----------------------------------------------------------
# Not shown under this name anywhere in the dashboard. It is
# https://<project-ref>.supabase.co -- the project-ref is in the dashboard URL
# (supabase.com/dashboard/project/<project-ref>), or use the Connect button.
# Also required to verify tokens on projects using asymmetric signing keys.
SUPABASE_URL=

# Settings -> API Keys. New projects name these "publishable" (sb_publishable_...)
# and "secret" (sb_secret_...); older ones call them anon and service_role.
SUPABASE_ANON_KEY=

# Server-side only. Bypasses row level security, so it must never be exposed to
# the browser, never given a NEXT_PUBLIC_ name, and never committed.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed if the project still uses the legacy shared HS256 secret
# (Settings -> JWT Keys -> Legacy JWT Secret). Projects on the newer asymmetric
# signing keys do not have one -- leave this blank and the API verifies via the
# JWKS endpoint derived from SUPABASE_URL instead.
SUPABASE_JWT_SECRET=

# --- OpenRouter ---------------------------------------------------------
# The single gateway for vision, reasoning and embeddings.
OPENROUTER_API_KEY=

# --- Frontend (apps/web/.env.local) -------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- LangSmith (optional; graph tracing) --------------------------------
# Leave LANGSMITH_TRACING unset or false and nothing is sent anywhere. When
# true, every graph run is uploaded to LangChain's servers -- including the
# retrieved knowledge-base text sitting in the prompts, which is the client's
# confidential material. Enable it for local debugging, not by default.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=vmlab-phase1
